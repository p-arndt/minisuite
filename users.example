# minicloak users file  (pass with  --users users.txt)
#
# One user per line.  A '#' starts a comment only at the beginning of a line,
# so it stays a legal password character.  Blank lines are ignored.
#
#   username = password : email : name : role1,role2
#
# Everything after `password` is optional: split on the first ':' for the
# password, then email, then display name, then a comma-separated role list.
# The display name is split on its first space into given_name / family_name.
# Fields are trimmed, so the columns below may be aligned for readability.

# full record: password, email, name, two roles
alice = alice : alice@example.com : Alice Admin : admin,staff

# password + email + name + one role
bob = bob : bob@example.com : Bob Dev : staff

# password only  (no email, name or roles)
carol = carolpass

# password + email only
dave = davepass : dave@example.com
